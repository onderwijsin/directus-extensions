{
	"name": "@onderwijsin/directus-extension-e2e-playground",
	"version": "0.1.0",
	"private": true,
	"description": "Private Directus extension playground for packed end-to-end tests",
	"keywords": [
		"directus-extension"
	],
	"homepage": "https://github.com/onderwijsin/directus-extensions#readme",
	"bugs": {
		"url": "https://github.com/onderwijsin/directus-extensions/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onderwijsin/directus-extensions.git",
		"directory": "extensions/directus-e2e-playground"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build --watch",
		"test": "vitest run --config ../../vitest.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@directus/memory": "catalog:",
		"@onderwijsin/directus-extension-utils": "workspace:*",
		"ioredis": "catalog:"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "catalog:",
		"@types/node": "catalog:node24",
		"@workspace/typescript-config": "workspace:*",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.10.0"
	},
	"directus:e2e": true,
	"directus:extension": {
		"type": "hook",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^12.2.0"
	}
}
