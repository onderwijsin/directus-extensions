{
	"name": "@onderwijsin/directus-ai-image-metadata-bundle",
	"version": "0.1.0",
	"description": "Generate accessible image descriptions, tags, and filenames from Directus Flows",
	"keywords": [
		"accessibility",
		"ai",
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"homepage": "https://github.com/onderwijsin/directus-extensions#readme",
	"bugs": {
		"url": "https://github.com/onderwijsin/directus-extensions/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Onderwijs in",
		"email": "hallo@onderwijsin.nl",
		"url": "https://github.com/onderwijsin"
	},
	"contributors": [
		{
			"name": "Remi Huigen",
			"email": "remihuigen@onderwijsin.nl",
			"url": "https://github.com/remihuigen"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onderwijsin/directus-extensions.git",
		"directory": "extensions/directus-ai-image-metadata-bundle"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./dist/api.js",
	"exports": {
		".": "./dist/api.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add",
		"validate": "directus-extension validate",
		"test:unit": "vitest run --config ../../vitest.config.ts",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "catalog:",
		"@ai-sdk/google": "catalog:",
		"@ai-sdk/mistral": "catalog:",
		"@ai-sdk/openai": "catalog:",
		"@directus/errors": "catalog:",
		"@onderwijsin/directus-extension-utils": "workspace:*",
		"ai": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "catalog:",
		"@directus/types": "catalog:",
		"@types/node": "catalog:node24",
		"@workspace/test-utils": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"vitest": "catalog:"
	},
	"icon": "image_search",
	"engines": {
		"node": ">=24.10.0"
	},
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"name": "ai-image-metadata",
				"type": "operation",
				"source": {
					"app": "src/ai-image-metadata/index.ts",
					"api": "src/ai-image-metadata/api.ts"
				}
			},
			{
				"name": "ai-image-metadata-regenerate",
				"type": "operation",
				"source": {
					"app": "src/ai-image-metadata-regenerate/index.ts",
					"api": "src/ai-image-metadata-regenerate/api.ts"
				}
			}
		],
		"host": ">=12.2.0 <13"
	}
}
