{
	"name": "@onderwijsin/directus-seeder-hook",
	"version": "0.0.0",
	"description": "Seed and extract Directus system data with three seeding strategies and development auto-extraction.",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-hook"
	],
	"homepage": "https://github.com/onderwijsin/directus-extensions#readme",
	"bugs": {
		"url": "https://github.com/onderwijsin/directus-extensions/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Onderwijs in",
		"email": "hallo@onderwijsin.nl",
		"url": "https://github.com/onderwijsin"
	},
	"contributors": [
		{
			"name": "Remi Huigen",
			"email": "remi@onderwijsin.nl",
			"url": "https://github.com/remihuigen"
		},
		{
			"name": "Jogchum Koerts",
			"email": "jogchum@onderwijsin.nl",
			"url": "https://github.com/joggienl"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onderwijsin/directus-extensions.git",
		"directory": "extensions/directus-seeder-hook"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"seeder.config.example.json",
		"seeder-config.schema.json"
	],
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./seeder-config.schema.json": "./seeder-config.schema.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"test:unit": "vitest run --config ../../vitest.config.ts --root ../..",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "catalog:",
		"@directus/types": "catalog:",
		"@onderwijsin/directus-extension-utils": "workspace:*",
		"@types/node": "catalog:node24",
		"@workspace/test-utils": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"commander": "catalog:",
		"pino": "catalog:",
		"vitest": "catalog:"
	},
	"icon": "extension",
	"engines": {
		"node": ">=24.10.0"
	},
	"directus:extension": {
		"type": "hook",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": ">=12.0.0 <13.0.0"
	}
}
