{
	"name": "@onderwijsin/directus-schema-snapshot-bundle",
	"version": "0.0.0",
	"description": "Split Directus schema snapshots into version-controlled YAML files and apply them with the SchemaService.",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"homepage": "https://github.com/onderwijsin/directus-extensions#readme",
	"bugs": {
		"url": "https://github.com/onderwijsin/directus-extensions/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Onderwijs in",
		"email": "hallo@onderwijsin.nl",
		"url": "https://github.com/onderwijsin"
	},
	"contributors": [
		{
			"name": "Remi Huigen",
			"email": "remi@onderwijsin.nl",
			"url": "https://github.com/remihuigen"
		},
		{
			"name": "Jogchum Koerts",
			"email": "jogchum@onderwijsin.nl",
			"url": "https://github.com/joggienl"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onderwijsin/directus-extensions.git",
		"directory": "extensions/directus-schema-snapshot-bundle"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./dist/api.js",
	"exports": {
		".": "./dist/api.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add",
		"validate": "directus-extension validate",
		"test:unit": "vitest run --config ../../vitest.config.ts --root ../..",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"js-yaml": "catalog:",
		"object-hash": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "catalog:",
		"@directus/types": "catalog:",
		"@onderwijsin/directus-extension-utils": "workspace:*",
		"@types/js-yaml": "catalog:",
		"@types/node": "catalog:node24",
		"@types/object-hash": "catalog:",
		"@workspace/test-utils": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"commander": "catalog:",
		"pino": "catalog:",
		"vitest": "catalog:"
	},
	"icon": "extension",
	"engines": {
		"node": ">=24.10.0"
	},
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "hook",
				"name": "cli-hook",
				"source": "src/cli-hook/index.ts"
			},
			{
				"type": "hook",
				"name": "auto-snapshot-hook",
				"source": "src/auto-snapshot-hook/index.ts"
			}
		],
		"host": ">=12.0.0 <13.0.0"
	}
}
