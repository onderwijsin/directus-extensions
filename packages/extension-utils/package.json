{
	"name": "@onderwijsin/directus-extension-utils",
	"version": "0.1.0",
	"description": "Reusable utilities for Onderwijs in Directus extensions",
	"keywords": [
		"directus",
		"directus-extension"
	],
	"homepage": "https://github.com/onderwijsin/directus-extensions#readme",
	"bugs": {
		"url": "https://github.com/onderwijsin/directus-extensions/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Onderwijs in",
		"email": "hallo@onderwijsin.nl",
		"url": "https://github.com/onderwijsin"
	},
	"contributors": [
		{
			"name": "Remi Huigen",
			"email": "remi@onderwijsin.nl",
			"url": "https://github.com/remihuigen"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onderwijsin/directus-extensions.git",
		"directory": "packages/extension-utils"
	},
	"files": [
		"dist",
		"extension.config.js",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./constants": {
			"types": "./dist/constants.d.ts",
			"import": "./dist/constants.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js"
		},
		"./app": {
			"types": "./dist/app/index.d.ts",
			"import": "./dist/app/index.js"
		},
		"./shared": {
			"types": "./dist/shared/index.d.ts",
			"import": "./dist/shared/index.js"
		},
		"./sentry": {
			"types": "./dist/server/sentry.d.ts",
			"import": "./dist/server/sentry.js"
		},
		"./extension.config.js": {
			"import": "./extension.config.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@directus/errors": "catalog:",
		"@directus/memory": "catalog:",
		"@sentry/node": "catalog:",
		"ioredis": "catalog:",
		"pino": "catalog:",
		"uuid": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@directus/types": "catalog:",
		"@types/express": "catalog:",
		"@types/node": "catalog:node24",
		"@workspace/typescript-config": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.10.0"
	}
}
