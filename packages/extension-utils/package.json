{
	"name": "@onderwijsin/directus-extension-utils",
	"version": "0.1.0",
	"description": "Framework-neutral utilities for Onderwijs in Directus extensions",
	"keywords": [
		"directus",
		"directus-extension"
	],
	"homepage": "https://github.com/onderwijsin/directus-extensions#readme",
	"bugs": {
		"url": "https://github.com/onderwijsin/directus-extensions/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onderwijsin/directus-extensions.git",
		"directory": "packages/extension-utils"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./guards": {
			"types": "./dist/guards.d.ts",
			"import": "./dist/guards.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@workspace/typescript-config": "workspace:*",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24.10.0"
	}
}
