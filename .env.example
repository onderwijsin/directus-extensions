# Copy to .env for local overrides. Compose defaults are safe for local development only.
# Compose only forwards explicitly mapped values. Examples marked "Compose override required"
# also need an environment entry in a Compose override; uncommenting them alone has no effect.
# See docs/environment.md for an example.
LICENSE_KEY= # Optional. If not provided, a license key will be requested on startup.
PUBLIC_URL=http://localhost:8055
DIRECTUS_SECRET=replace-with-a-local-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=p4ssw0rd!
DB_NAME=directus
DB_USER=directus
DEFAULT_PASSWORD=p4ssw0rd!

# Directus cache and startup coordination
CACHE_ENABLED=true
CACHE_STORE=redis
# Compose override required: local Compose supplies REDIS from the cache service.
# For external Redis, override REDIS in the Directus service. Component-based configuration
# requires removing that preset URL and forwarding REDIS_ENABLED and all four components.
# REDIS=redis://default:password@redis.example.com:6379/0
# REDIS_ENABLED=true
# REDIS_HOST=cache
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=p4ssw0rd!
CACHE_AUTO_PURGE=true
SYNCHRONIZATION_STORE=redis
SYNCHRONIZATION_NAMESPACE=directus-sync
DIRECTUS_EXTENSIONS_SCHEMA_CHANGES_ENABLED=true
DIRECTUS_EXTENSIONS_DATA_SEED_ENABLED=true
# Compose override required: optional lock and rate-limiter settings; unset uses synchronization.
# DIRECTUS_EXTENSIONS_LOCK_PROVIDER=redis
# DIRECTUS_EXTENSIONS_LOCK_REDIS_URL=redis://default:p4ssw0rd!@cache:6379/0
# DIRECTUS_EXTENSIONS_LOCK_FS_DIRECTORY=/directus/extensions/.locks
# DIRECTUS_EXTENSIONS_RATE_LIMITER_STORE=redis
DIRECTUS_POLICY_CACHE_INVALIDATION_ENABLED=true

# Database and uploads
DB_POOL__MIN=0
DB_POOL__MAX=10
FILES_MAX_UPLOAD_SIZE=200mb
TUS_ENABLED=false

# Cross-origin requests and local development
CORS_ENABLED=true
CORS_ORIGIN=true
# Optional CSP overrides forwarded by Compose.
# CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC="'self' http://localhost:*"
# CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_ANCESTORS="'self' http://localhost:*"
# CONTENT_SECURITY_POLICY_DIRECTIVES__CONNECT_SRC="'self' http://localhost:* https://* wss://*"
HSTS_ENABLED=true
MARKETPLACE_TRUST=sandbox
EXTENSIONS_MUST_LOAD=true
EXTENSIONS_AUTO_RELOAD=true
WEBSOCKETS_ENABLED=true
TELEMETRY=false

# Object storage and search
GARAGE_ACCESS_KEY_ID=directus
GARAGE_SECRET_ACCESS_KEY=directus-development-secret
STORAGE_BUCKET=directus
STORAGE_REGION=garage
# Garage internal RPC hostname; Directus's S3 endpoint stays on the local garage service.
STORAGE_HOST=garage
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=development-garage-admin-token
GARAGE_METRICS_TOKEN=development-garage-metrics-token
MEILISEARCH_MASTER_KEY=development-meilisearch-key

# Magic links
MAGIC_LINKS_ENABLED=true
MAGIC_LINKS_COLLECTION=magic_links
MAGIC_LINKS_SCHEMA_CHANGES_ENABLED=true
MAGIC_LINKS_DOCS_SEED_ENABLED=true
MAGIC_LINKS_SCHEMA_ABORT_ON_ERROR=true
MAGIC_LINKS_TOKEN_SECRET=development-magic-links-secret
MAGIC_LINKS_TOKEN_TTL=15m
MAGIC_LINKS_REDIRECT_URL_ALLOWLIST=array:https://app.example.com/auth/magic-link
MAGIC_LINKS_TOKEN_QUERY_PARAMETER=token
MAGIC_LINKS_EMAIL_TEMPLATE=magic-link
# Compose override required: optional email text and headers; leave unset for built-in fallbacks.
# MAGIC_LINKS_EMAIL_SUBJECT=Your sign-in link
# MAGIC_LINKS_EMAIL_PREVIEW_TEXT=Use this secure link to sign in to your account.
# MAGIC_LINKS_EMAIL_REPLY_TO=help@example.com
# MAGIC_LINKS_EMAIL_SENDER=Example App
USE_MAGIC_LINK_CLEANUP=false
MAGIC_LINK_CLEANUP_WINDOW=24h
MAGIC_LINK_CLEANUP_CRON=*/15 * * * *

# Directus email sender (forwarded by Compose)
EMAIL_FROM=noreply@localhost
# Compose override required: transport, templates and SMTP connection are fixed for local Mailpit.
# The values below are references, not .env switches. Credentials stay unset by default.
# EMAIL_TRANSPORT=smtp
# EMAIL_TEMPLATES_PATH=/directus/templates
# EMAIL_SMTP_HOST=mailpit
# EMAIL_SMTP_PORT=1025
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_IGNORE_TLS=false
# EMAIL_SMTP_POOL=false
# EMAIL_SMTP_NAME=
# EMAIL_MAILGUN_API_KEY=
# EMAIL_MAILGUN_DOMAIN=
# EMAIL_MAILGUN_HOST=api.mailgun.net
# EMAIL_SES_CREDENTIALS__ACCESS_KEY_ID=
# EMAIL_SES_CREDENTIALS__SECRET_ACCESS_KEY=
# EMAIL_SES_REGION=

# Enhanced server health endpoint
ENHANCED_SERVER_HEALTH_ENDPOINT_ENABLED=true
HEALTHCHECK_INCLUDE_CHECKS=array:*
HEALTHCHECK_INCLUDE_COMPONENTS=array:datastore,cache,objectstore,email,unknown
HEALTHCHECK_EXPOSE_WARNING_STATUS=false
# Compose override required: exclusions are unset by default (no exclusions).
# HEALTHCHECK_EXCLUDE_CHECKS=array:email
# HEALTHCHECK_EXCLUDE_COMPONENTS=array:email

# Policies endpoint
POLICIES_ENDPOINT_ENABLED=true
DIRECTUS_POLICIES_ENDPOINT_BYPASS_ACCOUNTABILITY=false

# Sentry (disabled by default; enabling it also requires the consumer runtime prerequisites)
SENTRY_ENABLED=false
SENTRY_TEST_SUITE_ENABLED=false
SENTRY_RELEASE_PREFIX=dev
SOURCE_COMMIT=unknown
DEPLOYMENT_ENV=development
# Compose override required: keep optional Sentry values unset rather than passing empty strings.
# SENTRY_DSN=https://public@example.ingest.sentry.io/123456
# SENTRY_LOADER_SCRIPT=<script src="https://js-de.sentry-cdn.com/0123456789abcdef0123456789abcdef.min.js" crossorigin="anonymous"></script>
# SENTRY_RELEASE=dev@local

# Shared AI configuration (used by the Markdown Editor and image metadata operations)
DIRECTUS_EXTENSIONS_AI_PROVIDER=mistral
DIRECTUS_EXTENSIONS_AI_MODEL=mistral-medium-latest
DIRECTUS_EXTENSIONS_AI_API_KEY=

# Coolify deployments: provide a real instance URL and token.
COOLIFY_DEPLOYMENTS_ENABLED=true
COOLIFY_DEPLOYMENTS_SAME_ORIGIN_ENABLED=true
COOLIFY_APPLICATIONS_COLLECTION=coolify_applications
COOLIFY_DEPLOYMENTS_SCHEMA_CHANGES_ENABLED=true
COOLIFY_DEPLOYMENTS_DOCS_SEED_ENABLED=true
COOLIFY_DEPLOYMENTS_SCHEMA_ABORT_ON_ERROR=true
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=replace-with-a-coolify-api-token
# Compose override required: advanced polling and policy identifiers use extension defaults.
# COOLIFY_DEPLOYMENTS_POLL_INTERVAL_MS=5000
# COOLIFY_DEPLOYMENTS_MANAGE_APPLICATIONS_POLICY_ID=0c9f0b1e-0a0b-4b7c-8a27-4b7a6e1f2d31
# COOLIFY_DEPLOYMENTS_READ_DEPLOYMENTS_POLICY_ID=2e7a4c63-1d5f-46bb-9b02-8f3c7a5d6e14
# COOLIFY_DEPLOYMENTS_TRIGGER_DEPLOYMENTS_POLICY_ID=7b3d9e20-5f61-4a8c-b274-1e6d9f0a3c58

# Sluggernaut
SLUGGERNAUT_ENABLED=true
SLUGGERNAUT_REDIRECTS_ENABLED=true
SLUGGERNAUT_REDIRECTS_COLLECTION=redirects
SLUGGERNAUT_MAX_REDIRECT_GRAPH_DEPTH=25
SLUGGERNAUT_FIELDS_CACHE_TTL_MS=60000
SLUGGERNAUT_SCHEMA_CHANGES_ENABLED=true
SLUGGERNAUT_DOCS_SEED_ENABLED=true
SLUGGERNAUT_SCHEMA_ABORT_ON_ERROR=true
SLUGGERNAUT_MANAGE_REDIRECTS_POLICY_ENABLED=true
SLUGGERNAUT_READ_ACTIVE_REDIRECTS_POLICY_ENABLED=true

# Loops
LOOPS_ENABLED=true
LOOPS_SYNC_ENABLED=true
LOOPS_SCHEMA_CHANGES_ENABLED=true
LOOPS_DOCS_SEED_ENABLED=true
LOOPS_MANAGE_EMAIL_CAMPAIGNS_POLICY_ENABLED=true
LOOPS_VIEW_EMAIL_CAMPAIGNS_POLICY_ENABLED=true
# LOOPS_API_KEY=replace-with-a-loops-api-key
LOOPS_WEBHOOK_SIGNING_SECRET=
LOOPS_API_BASE_URL=https://app.loops.so
LOOPS_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
LOOPS_WEBHOOK_EVENT_ALLOWLIST=array:campaign.email.sent,contact.deleted
LOOPS_CAMPAIGN_PROCESSING_LEASE_MS=300000
LOOPS_LMX_PARSING_MODE=best_effort
LOOPS_SYNC_ENABLED_FIELD=loops_sync_enabled

# AI image metadata
AI_METADATA_WRITER_ENABLED=true

# Markdown editor
MARKDOWN_EDITOR_ENABLED=true
MARKDOWN_EDITOR_SCHEMA_CHANGES_ENABLED=true
MARKDOWN_EDITOR_DOCS_SEED_ENABLED=true
MARKDOWN_EDITOR_SKILLS_SEED_ENABLED=true

# Studio docs
DIRECTUS_DOCS_ENABLED=true
DIRECTUS_DOCS_SCHEMA_CHANGES_ENABLED=true
DIRECTUS_DOCS_SEED_ENABLED=true
DIRECTUS_DOCS_MANAGE_POLICY_ENABLED=true
DIRECTUS_DOCS_VIEW_POLICY_ENABLED=true
